{
  "expo": {
    "name": "Riwaya",
    "slug": "riwaya",
    "version": "1.0.0",
    "description": "Riwaya — Librairie en ligne & Communauté de lecteurs (Paiement à la livraison au Maroc)",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riwaya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "store.riwaya.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "store.riwaya.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permettre à Riwaya d'utiliser votre position pour trouver des livres autour de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Riwaya a besoin d'accéder à vos photos pour sélectionner les clichés de vos livres.",
          "cameraPermission": "Riwaya a besoin d'accéder à l'appareil photo pour photographier directement vos livres d'occasion."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
