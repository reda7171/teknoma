{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "ready on|Listening on|http://localhost:3000",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/fr",
        "http://localhost:3000/fr/packs",
        "http://localhost:3000/fr/books/08f41f86-a23c-48f6-b486-109383b0f6e0",
        "http://localhost:3000/ar",
        "http://localhost:3000/en"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "server-response-time": ["warn", { "maxNumericValue": 2000 }],
        "color-contrast": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
