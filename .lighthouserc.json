{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "ready on|Listening on|http://localhost:3000",
      "startServerReadyTimeout": 60000,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --ignore-certificate-errors --disable-setuid-sandbox --disable-dev-shm-usage"
      },
      "url": [
        "http://localhost:3000/fr",
        "http://localhost:3000/fr/books",
        "http://localhost:3000/fr/packs",
        "http://localhost:3000/ar",
        "http://localhost:3000/en"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.60 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.90 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 5500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.15 }],
        "total-blocking-time": ["error", { "maxNumericValue": 850 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "server-response-time": ["warn", { "maxNumericValue": 2000 }],
        "color-contrast": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
